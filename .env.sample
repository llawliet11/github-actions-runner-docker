# Registry credentials
#REGISTRY_URL=my-registry.example.com
#REGISTRY_USERNAME=my-username
#REGISTRY_PASSWORD=my-password

# Which Dockerfile variant to build from:
#   Dockerfile               - base: node + aws-cli (frontend builds, S3 deploys)
#   Dockerfile.docker-build  - base + docker CLI (for jobs that docker build / push to ECR)
DOCKERFILE=Dockerfile

# --- Per-clone knobs --------------------------------------------------------
# Set these here instead of editing docker-compose.yml. Local edits to the
# tracked compose file conflict with `git pull` and are invisible to the next
# clone; anything not covered here belongs in docker-compose.override.yml
# (gitignored, auto-merged by compose).

# Image tag for this runner. Defaults to the compose project name, i.e. the
# clone's directory name, so sibling clones never overwrite each other's image.
# Set it only to pin a tag, or to `latest` to deliberately share one image.
#RUNNER_IMAGE_TAG=

# Restart policy for the service model (`docker compose up -d`). Keep the
# default: --ephemeral exits after one job, so this is what starts the next
# runner. Set to `no` only under the supervisor model, where it is ignored.
#RUNNER_RESTART_POLICY=unless-stopped

# GID of this HOST's /var/run/docker.sock. REQUIRED if any job in the target
# repo declares `services:` containers - the runner talks to the socket to
# create them as siblings, and a mismatched GID fails `Initialize containers`
# with "permission denied ... /var/run/docker.sock". A wrong value is inert,
# not fatal, so it is safe to set. Find it with:
#   stat -c '%g' /var/run/docker.sock
#DOCKER_SOCK_GID=999

# GitHub repository or organization URL
NODE_VERSION=18
GITHUB_PAT=
GITHUB_OWNER=
GITHUB_REPOSITORY=

RUNNER_LABELS=self-hosted
RUNNER_VERSION=2.334.0
# If there is no RUNNER_NAME - auto naming
#RUNNER_NAME=
#RUNNER_REPO=
#RUNNER_TOKEN=
